        "get_weather": {
          "name": "get_weather",
          "description": "Текущая погода в городе. city принимает только название на русском языке; переведи иностранное название города и указанные страну/регион на русский до вызова. Не расширяй короткое имя и не дополняй неуказанную страну/регион. При одноимённых городах место выбирает пользователь, а не модель. Это наблюдение, а не прогноз на весь день.",
          "inputSchema": {
            "type": "object",
            "$defs": {
              "Coordinates": {
                "additionalProperties": false,
                "properties": {
                  "latitude": {
                    "maximum": 90,
                    "minimum": -90,
                    "title": "Latitude",
                    "type": "number"
                  },
                  "longitude": {
                    "maximum": 180,
                    "minimum": -180,
                    "title": "Longitude",
                    "type": "number"
                  },
                  "timezone": {
                    "maxLength": 100,
                    "minLength": 1,
                    "title": "Timezone",
                    "type": "string"
                  }
                },
                "required": [
                  "latitude",
                  "longitude",
                  "timezone"
                ],
                "title": "Coordinates",
                "type": "object"
              },
              "WeatherArguments": {
                "additionalProperties": false,
                "properties": {
                  "city": {
                    "description": "Название города на русском языке с той же точностью, что у пользователя. Переведи иностранное название, но не расширяй короткое имя до другого полного названия. Страна и регион допустимы только из явного запроса пользователя или явно выбранного им варианта. Не угадывай их по своим знаниям, языку сообщения, часовому поясу или популярности города. Для запроса без уточнений передай только название города: неоднозначность выявляет MCP, место выбирает пользователь. Если пользователь указал город и страну вместе, переведи обе указанные части. После явного выбора однозначного полного имени достаточно самого имени: не требуй дописывать страну/регион из подписи кандидата. Латиница и ISO-коды стран не принимаются.",
                    "examples": [
                      "Ростов",
                      "Москва",
                      "Казань, Россия"
                    ],
                    "maxLength": 100,
                    "minLength": 1,
                    "pattern": "^[А-Яа-яЁё][А-Яа-яЁё .'’\\-‐‑‒–—]*(?:, *[А-Яа-яЁё][А-Яа-яЁё .'’\\-‐‑‒–—]*)*$",
                    "title": "City",
                    "type": "string"
                  }
                },
