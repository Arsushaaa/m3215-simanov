# Скопируйте в .env для локального запуска или воспользуйтесь start-скриптом.
# Для облака deploy-скрипт создаёт отдельный .env.cloud.
# Никогда не публикуйте настоящий токен или пароль в Git.

# Токен бота от @BotFather (обязательно).
BOT_TOKEN=

# OpenRouter: ключ обязателен для запуска приложения.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=2048
# Чётное число сообщений; в запросе сохраняются только целые пары истории.
HISTORY_MAX_MESSAGES=20
# Оценочный бюджет запроса, включая системную инструкцию и текущий вопрос.
HISTORY_MAX_TOKENS=6000

# ЛР2: чтение MCP подключено в /study; подтверждения добавляются следующим этапом.
# В Git/Docker/архив деплоя входит только учебный файл. Личный путь допустим
# локально; автоматический cloud-deploy принимает только data/schedule.json.
SCHEDULE_FILE=data/schedule.json
SCHEDULE_TIMEZONE=Europe/Moscow
MCP_TIMEOUT_SECONDS=15
AGENT_TIMEOUT_SECONDS=135
# Текущий бесплатный endpoint не заявляет tool_choice=none для native-финала.
LLM_TOOL_MODE=structured

# Локально можно оставить пустым; в облаке прокси обязателен.
# Примеры: http://user:password@proxy.example:3128 или socks5://proxy.example:1080
# Символы @, :, / в логине/пароле кодируйте как %40, %3A, %2F.
TELEGRAM_PROXY_URL=

# Локально: 127.0.0.1 и опубликованный порт. В облаке: db и 5432.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=bot
POSTGRES_USER=bot
# Скрипт сгенерирует пароль, если поле пустое. После создания БД не меняйте его
# только в env-файле: пароль роли PostgreSQL хранится внутри самой БД.
POSTGRES_PASSWORD=

LOG_LEVEL=INFO
# Служебный HTTP-порт на 127.0.0.1; наружу в облаке не публикуется.
HEALTH_PORT=8080
